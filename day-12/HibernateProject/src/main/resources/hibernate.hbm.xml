<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC 
"-//Hibernate/Hibernate Mapping DTD//EN"
"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
	<class name="com.coforge.model.Employee" table="Employee">
		<id name="empId" column="empId">
			<generator class="assigned"></generator>
		</id>
		<property name="empName" column="empName"></property>
		<property name="empSalary" column="empSalary"></property>
		<property name="empDepartment" column="empDepartment"></property>
		<property name="empEmail" column="empEmail"></property>
	</class>	
	
		
</hibernate-mapping>